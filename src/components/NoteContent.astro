---
import { eventHasMapGeometry, historicalDateToNumber, type Note } from "../data/note";
import { noteEventTimeToString, splitNoteLinks } from "../data/note";
import peopleDirectory from "../data/people.json";

interface Props {
  note: Note;
  focusMappedEvents?: boolean;
  mapHref?: string;
}

const { note, focusMappedEvents = false, mapHref } = Astro.props;
const sectionId = (title: string) => title.toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const sectionDateLabel = (section: (typeof note.timeline)[number]) => section.dateRange
  ? `(${noteEventTimeToString({ type: "range", from: section.dateRange[0], to: section.dateRange[1] }).trim()})`
  : "";
const firstAppearance = new Map<string, number>();
for (const event of note.events) {
  const eventStart = event.time.type === "single" ? event.time.date : event.time.from;
  const date = eventStart.period === "BCE" ? -eventStart.year : eventStart.year;
  for (const person of event.people) {
    firstAppearance.set(person.slug, Math.min(firstAppearance.get(person.slug) ?? Infinity, date));
  }
}
const peopleByCategory = note.people.reduce((groups, person) => {
  const category = peopleDirectory[person.slug as keyof typeof peopleDirectory]?.category ?? "Other";
  groups.set(category, [...(groups.get(category) ?? []), person]);
  return groups;
}, new Map<string, typeof note.people>());
---

<article>
  <h2 class="mb-3 font-bold text-3xl">{note.name}</h2>

  {note.descriptions.map((description) => <p class="mb-2">{splitNoteLinks(description).map((part) => part.href ? <a class="underline" href={part.href}>{part.text}</a> : part.text)}</p>)}

  {mapHref && <p class="my-3"><a class="underline" href={mapHref}>Open map view →</a></p>}

  {note.timeline.some((section) => section.title) && <nav class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">In this note</h2><ul class="list-disc pl-6">{note.timeline.filter((section) => section.title).map((section) => <li><a class="underline" href={`#${sectionId(section.title!)}`}>{section.title}{sectionDateLabel(section) && <span class="ml-1">{sectionDateLabel(section)}</span>}</a></li>)}</ul></nav>}

  {note.people.length > 0 && <section class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">People involved</h2><div class="flex flex-col gap-3">{[...peopleByCategory].sort(([a], [b]) => a.localeCompare(b)).map(([category, people]) => <div><h3 class="font-semibold mb-1">{category}</h3><ul class="flex flex-wrap gap-x-3 gap-y-1">{[...people].sort((a, b) => (firstAppearance.get(a.slug) ?? Infinity) - (firstAppearance.get(b.slug) ?? Infinity) || a.name.localeCompare(b.name)).map((person) => <li><a class="underline" href={`/person/${person.slug}`}>{peopleDirectory[person.slug as keyof typeof peopleDirectory]?.name ?? person.name}</a></li>)}</ul></div>)}</div></section>}

  {note.locations.length > 0 && <section class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">Locations</h2><ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">{note.locations.map((location) => <li class="min-w-0 break-words"><a class="underline" href={`/location/${location.slug}`}>{location.name}</a>{location.description && <p class="mt-1 text-sm text-gray-600">{location.description}</p>}</li>)}</ul></section>}

  <h3 class="text-2xl font-bold mb-2">Timeline</h3>

  {note.timeline.map((section) => <div data-note-timeline-section={focusMappedEvents ? "" : undefined}>
    {section.title && <h4 id={sectionId(section.title)} class="font-semibold text-xl mb-2">{section.titleSegments?.map((part) => part.person ? <a class="underline" href={`/person/${part.person.slug}`}>{part.text}</a> : part.location ? <a class="underline" href={`/location/${part.location.slug}`}>{part.text}</a> : part.text) ?? section.title}{sectionDateLabel(section) && <span class="ml-2 text-base font-normal text-gray-500">{sectionDateLabel(section)}</span>}</h4>}
    <ol class="flex flex-col gap-0.5 mb-4">
      {section.events.map((event) => {
        const focusable = focusMappedEvents && eventHasMapGeometry(event);
        const eventStart = event.time.type === "single" ? event.time.date : event.time.from;
        const eventEnd = event.time.type === "single" ? event.time.date : event.time.to;
        return <li
          data-map-event-index={focusable ? note.events.indexOf(event) : undefined}
          data-note-event-index={focusMappedEvents ? note.events.indexOf(event) : undefined}
          data-note-event-start={focusMappedEvents ? historicalDateToNumber(eventStart) : undefined}
          data-note-event-end={focusMappedEvents ? historicalDateToNumber(eventEnd) : undefined}
          tabindex={focusable ? 0 : undefined}
          role={focusable ? "button" : undefined}
          aria-label={focusable ? `Focus ${noteEventTimeToString(event.time)} event on map` : undefined}
          class={focusable ? "cursor-pointer hover:underline focus-visible:underline" : undefined}
        ><span class="font-bold">{noteEventTimeToString(event.time)}</span>:{" "}{splitNoteLinks(event.description).map((part) => part.href ? <a class="underline" href={part.href}>{part.text}</a> : part.text)}</li>;
      })}
    </ol>
    {section.images.length > 0 && <div class="flex flex-col gap-2 mb-4">{section.images.map((image) => <figure class="rounded-md border border-gray-300 overflow-hidden max-w-2xl"><img src={image.src} alt={image.alt} loading="lazy" class="w-full h-auto object-cover" />{(image.alt || image.source) && <figcaption class="text-xs px-2 py-0.5 flex flex-col gap-0.5">{image.alt && <span class="font-semibold">{image.alt}</span>}{image.source && <a href={image.source.url} target="_blank" rel="noopener noreferrer" class="underline">{image.source.label}</a>}</figcaption>}</figure>)}</div>}
  </div>)}

  {note.gallery.length > 0 && <section class="mt-4">
    <h3 class="text-2xl font-bold mb-2">Gallery</h3>
    <div class="flex flex-col gap-2">{note.gallery.map((image) => <figure class="rounded-md border border-gray-300 overflow-hidden max-w-2xl"><img src={image.src} alt={image.alt} loading="lazy" class="w-full h-auto object-cover" />{(image.alt || image.source) && <figcaption class="text-xs px-2 py-0.5 flex flex-col gap-0.5">{image.alt && <span class="font-semibold">{image.alt}</span>}{image.source && <a href={image.source.url} target="_blank" rel="noopener noreferrer" class="underline">{image.source.label}</a>}</figcaption>}</figure>)}</div>
  </section>}
</article>
