---
import type { InferGetStaticPropsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import {
  parseMarkdownIntoNote,
  noteEventTimeToString,
  getNoteTimeSpan,
  sortNotesByFileName,
  splitNoteLinks,
  type Note,
} from "../../data/note";
import NoteMap from "../../components/NoteMap";
import peopleDirectory from "../../data/people.json";

export async function getStaticPaths() {
  const allNotes = await getCollection("notes");

  const notes = allNotes
    .map((n) => parseMarkdownIntoNote(n.filePath, n.body, n.data.locations))
    .filter((n): n is Note => n != null);

  return notes.map((note) => {
    const series = sortNotesByFileName(
      notes.filter((n) => n.topic === note.topic),
    );
    const currentIndex = series.findIndex((n) => n.path === note.path);

    const prev = currentIndex > 0 ? series[currentIndex - 1] : null;
    const next =
      currentIndex < series.length - 1 ? series[currentIndex + 1] : null;

    const [noteStart, noteEnd] = getNoteTimeSpan(note);
    const elsewhere = notes
      .filter((n) => n.topic !== note.topic)
      .filter((n) => {
        const [start, end] = getNoteTimeSpan(n);
        return start <= noteEnd && end >= noteStart;
      })
      .sort((a, b) => getNoteTimeSpan(a)[0] - getNoteTimeSpan(b)[0]);

    return {
      params: { path: note.path },
      props: { note, prev, next, series, elsewhere },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note, prev, next, series, elsewhere } = Astro.props;
const hasMap = note.locations.some((location) => location.coordinates) || note.events.some((event) => event.location != null || event.locations.some((location) => location.coordinates));
const sectionId = (title: string) => title.toLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const sectionDateLabel = (section: (typeof note.timeline)[number]) => section.dateRange
  ? `(${noteEventTimeToString({ type: "range", from: section.dateRange[0], to: section.dateRange[1] }).trim()})`
  : "";
const firstAppearance = new Map<string, number>();
for (const event of note.events) {
  const eventStart = event.time.type === "single"
    ? event.time.date
    : event.time.from;
  const date = eventStart.period === "BCE" ? -eventStart.year : eventStart.year;
  for (const person of event.people) {
    firstAppearance.set(person.slug, Math.min(firstAppearance.get(person.slug) ?? Infinity, date));
  }
}
const peopleByCategory = note.people.reduce((groups, person) => {
  const category = peopleDirectory[person.slug as keyof typeof peopleDirectory]?.category ?? "Other";
  groups.set(category, [...(groups.get(category) ?? []), person]);
  return groups;
}, new Map<string, typeof note.people>());
---

<Layout title={note.name}>
  <nav class="flex justify-between gap-2 mb-3">
    {
      prev ? (
        <a href={`/note/${prev.path}`} class="underline">
          ← {prev.name}
        </a>
      ) : (
        <span />
      )
    }

    {
      next ? (
        <a href={`/note/${next.path}`} class="underline">
          {next.name} →
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <h2 class="mb-3 font-bold text-3xl">{note.name}</h2>

  {note.descriptions.map((d) => <p class="mb-2">{splitNoteLinks(d).map((part) => part.href ? <a class="underline" href={part.href}>{part.text}</a> : part.text)}</p>)}

  {note.timeline.some((section) => section.title) && <nav class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">In this note</h2><ul class="list-disc pl-6">{note.timeline.filter((section) => section.title).map((section) => <li><a class="underline" href={`#${sectionId(section.title!)}`}>{section.title}{sectionDateLabel(section) && <span class="ml-1">{sectionDateLabel(section)}</span>}</a></li>)}</ul></nav>}

  {note.people.length > 0 && <section class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">People involved</h2><div class="flex flex-col gap-3">{[...peopleByCategory].sort(([a], [b]) => a.localeCompare(b)).map(([category, people]) => <div><h3 class="font-semibold mb-1">{category}</h3><ul class="flex flex-wrap gap-x-3 gap-y-1">{[...people].sort((a, b) => (firstAppearance.get(a.slug) ?? Infinity) - (firstAppearance.get(b.slug) ?? Infinity) || a.name.localeCompare(b.name)).map((person) => <li><a class="underline" href={`/person/${person.slug}`}>{peopleDirectory[person.slug as keyof typeof peopleDirectory]?.name ?? person.name}</a></li>)}</ul></div>)}</div></section>}

  {note.locations.length > 0 && <section class="my-5 rounded border border-gray-300 p-4"><h2 class="font-bold text-2xl mb-2">Locations</h2><ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">{note.locations.map((location) => <li class="min-w-0 break-words"><a class="underline" href={`/location/${location.slug}`}>{location.name}</a>{location.description && <p class="mt-1 text-sm text-gray-600">{location.description}</p>}</li>)}</ul></section>}

  <h3 class="text-2xl font-bold mb-2">Timeline</h3>

  {
    note.timeline.map((section) => (
      <div>
        {section.title && (
          <h4 id={sectionId(section.title)} class="font-semibold text-xl mb-2">{section.titleSegments?.map((part) => part.person ? <a class="underline" href={`/person/${part.person.slug}`}>{part.text}</a> : part.location ? <a class="underline" href={`/location/${part.location.slug}`}>{part.text}</a> : part.text) ?? section.title}{sectionDateLabel(section) && <span class="ml-2 text-base font-normal text-gray-500">{sectionDateLabel(section)}</span>}</h4>
        )}
        <ol class="flex flex-col gap-0.5 mb-4">
          {section.events.map((e) => (
            <li>
              <span class="font-bold">{noteEventTimeToString(e.time)}</span>:{" "}
              {splitNoteLinks(e.description).map((part) => part.href ? <a class="underline" href={part.href}>{part.text}</a> : part.text)}
            </li>
          ))}
        </ol>
        {section.images.length > 0 && <div class="flex flex-col gap-2 mb-4">{section.images.map((img) => <figure class="rounded-md border border-gray-300 overflow-hidden max-w-2xl"><img src={img.src} alt={img.alt} loading="lazy" class="w-full h-auto object-cover" />{(img.alt || img.source) && <figcaption class="text-xs px-2 py-0.5 flex flex-col gap-0.5">{img.alt && <span class="font-semibold">{img.alt}</span>}{img.source && <a href={img.source.url} target="_blank" rel="noopener noreferrer" class="underline">{img.source.label}</a>}</figcaption>}</figure>)}</div>}
      </div>
    ))
  }

  {hasMap && <NoteMap events={note.events} places={note.locations} client:only="react" />}

  {
    note.gallery.length > 0 && (
      <section class="mt-4">
        <h3 class="text-2xl font-bold mb-2">Gallery</h3>

        <div class="flex flex-col gap-2">
          {note.gallery.map((img) => (
            <figure class="rounded-md border border-gray-300 overflow-hidden max-w-2xl">
              <img
                src={img.src}
                alt={img.alt}
                loading="lazy"
                class="w-full h-auto object-cover"
              />
              {(img.alt || img.source) && (
                <figcaption class="text-xs px-2 py-0.5 flex flex-col gap-0.5">
                  {img.alt && <span class="font-semibold">{img.alt}</span>}
                  {img.source && (
                    <a
                      href={img.source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="underline"
                    >
                      {img.source.label}
                    </a>
                  )}
                </figcaption>
              )}
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <section class="mt-8 flex flex-col sm:flex-row gap-6">
    <div class="flex-1">
      <h3 class="text-xl font-bold mb-2">Happening elsewhere at the time</h3>

      {
        elsewhere.length > 0 ? (
          <ul class="flex flex-col gap-1">
            {elsewhere.map((n) => (
              <li>
                <a href={`/note/${n.path}`} class="underline">
                  {n.name}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Nothing found.</p>
        )
      }
    </div>

    <div class="flex-1">
      <h3 class="text-xl font-bold mb-2">{note.topic} series</h3>

      <ul class="flex flex-col gap-1">
        {
          series.map((n) =>
            n.path === note.path ? (
              <li>
                <span class="font-bold">{n.name}</span>
              </li>
            ) : (
              <li>
                <a href={`/note/${n.path}`} class="underline">
                  {n.name}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </section>
</Layout>
