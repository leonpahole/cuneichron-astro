---
import type { InferGetStaticPropsType } from "astro";
import Layout from "../../layouts/Layout.astro";
import { getCollection } from "astro:content";
import {
  parseMarkdownIntoNote,
  getNoteTimeSpan,
  sortNotesByFileName,
  noteHasMap,
  type Note,
} from "../../data/note";
import NoteContent from "../../components/NoteContent.astro";

export async function getStaticPaths() {
  const allNotes = await getCollection("notes");

  const notes = allNotes
    .map((n) => parseMarkdownIntoNote(n.filePath, n.body, n.data.locations, n.data.people))
    .filter((n): n is Note => n != null);

  return notes.map((note) => {
    const series = sortNotesByFileName(
      notes.filter((n) => n.topic === note.topic),
    );
    const currentIndex = series.findIndex((n) => n.path === note.path);

    const prev = currentIndex > 0 ? series[currentIndex - 1] : null;
    const next =
      currentIndex < series.length - 1 ? series[currentIndex + 1] : null;

    const [noteStart, noteEnd] = getNoteTimeSpan(note);
    const elsewhere = notes
      .filter((n) => n.topic !== note.topic)
      .filter((n) => {
        const [start, end] = getNoteTimeSpan(n);
        return start <= noteEnd && end >= noteStart;
      })
      .sort((a, b) => getNoteTimeSpan(a)[0] - getNoteTimeSpan(b)[0]);

    return {
      params: { path: note.path },
      props: { note, prev, next, series, elsewhere },
    };
  });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { note, prev, next, series, elsewhere } = Astro.props;
const hasMap = noteHasMap(note);
---

<Layout title={note.name}>
  <nav class="flex items-center justify-between gap-3 mb-3">
    {
      prev ? (
        <a href={`/note/${prev.path}`} class="underline">
          ← {prev.name}
        </a>
      ) : (
        <span />
      )
    }

    {
      next ? (
        <a href={`/note/${next.path}`} class="underline">
          {next.name} →
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <NoteContent note={note} mapHref={hasMap ? `/map/${note.path}` : undefined} />

  <section class="mt-8 flex flex-col sm:flex-row gap-6">
    <div class="flex-1">
      <h3 class="text-xl font-bold mb-2">Happening elsewhere at the time</h3>

      {
        elsewhere.length > 0 ? (
          <ul class="flex flex-col gap-1">
            {elsewhere.map((n) => (
              <li>
                <a href={`/note/${n.path}`} class="underline">
                  {n.name}
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-gray-400">Nothing found.</p>
        )
      }
    </div>

    <div class="flex-1">
      <h3 class="text-xl font-bold mb-2">{note.topic} series</h3>

      <ul class="flex flex-col gap-1">
        {
          series.map((n) =>
            n.path === note.path ? (
              <li>
                <span class="font-bold">{n.name}</span>
              </li>
            ) : (
              <li>
                <a href={`/note/${n.path}`} class="underline">
                  {n.name}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('a[href^="/map/"]');
    const currentNotePath = window.location.pathname.replace(/^\/note\//, "").replace(/\/$/, "");
    if (!link || new URL(link.href).pathname !== `/map/${currentNotePath}` || !window.location.search) return;
    const destination = new URL(link.href);
    destination.search = window.location.search;
    link.href = destination.toString();
  });
</script>
