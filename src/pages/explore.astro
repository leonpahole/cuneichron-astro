---
import Layout from "../layouts/Layout.astro";
import ExploreView from "../components/explore/ExploreView.astro";
import { getNotes, groupNotes } from "../data/explore";

const notes = await getNotes();
const buckets = groupNotes("topic", notes);
---

<Layout title="Explore">
  <ExploreView view="topic" buckets={buckets} />
</Layout>
