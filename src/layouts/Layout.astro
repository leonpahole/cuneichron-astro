---
import "../styles/global.css";
import NavBar from "../components/NavBar.astro";
import { Font } from "astro:assets";

interface Props {
  title: string;
  fullWidth?: boolean;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title} | Leon's History Notes</title>
    <Font cssVariable="--font-sans" />
  </head>
  <body class="font-sans">
    <div class={Astro.props.fullWidth ? "flex h-dvh w-full flex-col overflow-hidden px-4" : "max-w-7xl px-6 mx-auto"}>
      <NavBar />
      <main class={Astro.props.fullWidth ? "min-h-0 flex-1 overflow-hidden pb-2 text-lg" : "pb-8 text-lg"}>
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
